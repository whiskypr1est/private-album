[Unit]
Description=Private Photo Album (FastAPI) for Raspberry Pi
Documentation=file:///home/cabbage/photoalbum/README.md
# 相册数据放在 LUKS 加密的 USB 硬盘上，必须先解锁挂载好，服务才能启动。
# Requires 让「硬盘不在」时服务直接启动失败，而不是在 SD 卡上凭空建出一个
# 空 data 目录 —— 那样界面会显示 0 张照片，看起来就像照片全丢了（真踩过）。
After=network-online.target tailscaled.service photoalbum-disk.service
Wants=network-online.target
Requires=photoalbum-disk.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cabbage
Group=cabbage
WorkingDirectory=/home/cabbage/photoalbum/server/app
Environment=PYTHONUNBUFFERED=1
Environment=PHOTOALBUM_HOME=/home/cabbage/photoalbum
# ⚠️ 这个路径在加密盘上，改回 $HOME/data 会在 SD 卡上建出空库，
# 界面显示 0 张照片（而且会创建随机密码的新账号，导致登录失败）。
# 解锁+挂载由 photoalbum-disk.service 负责（/usr/local/sbin/photoalbum-disk.sh）。
Environment=PHOTOALBUM_DATA_DIR=/mnt/photoalbum/data
Environment=PHOTOALBUM_LOG_DIR=/home/cabbage/photoalbum/logs
Environment=PHOTOALBUM_TZ=Asia/Shanghai
ExecStart=/home/cabbage/photoalbum/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8080 --workers 1 --timeout-keep-alive 75 --no-access-log
Restart=always
RestartSec=5
# Photo indexing is I/O bound; keep it gentle on the USB disk.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
StandardOutput=append:/home/cabbage/photoalbum/logs/service.log
StandardError=append:/home/cabbage/photoalbum/logs/service.log
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
