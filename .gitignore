# ---------- 机密：绝对不要提交 ----------
# SSH 私钥（能直接登录树莓派）
.ssh/
*.pem
id_ed25519*
id_rsa*

# 明文口令 / 连接信息
photoalbum/deploy/local.env
树莓派ssh.txt

# ---------- 运行期数据（用户照片，属于隐私）----------
photoalbum/data/
photoalbum/logs/
photoalbum/venv/
__pycache__/
*.py[cod]
*.db
*.db-wal
*.db-shm

# ---------- 构建产物 / 安装包 ----------
*.apk
*.aab
*.tar
*.zip

# ---------- 调试与临时文件 ----------
trace.log
*.log
.tmp-*

# ---------- 工具中间产物 ----------
.dsh-vision-toolkit/
